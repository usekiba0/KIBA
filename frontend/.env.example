# Backend API base, including the /v1 prefix.
NEXT_PUBLIC_API_URL=https://kiba-1.onrender.com/v1

# Legal pages linked from the A2P consent disclosure on the signup form
# (Step4Contact).
#
# ⚠️ LEAVE THESE UNSET. Unset, Step4Contact falls back to the relative "/privacy"
# and "/sms-terms" — this app's own server-rendered pages, whose text is the
# compliant one (backend/src/data/legal-content.ts).
#
# Do NOT point them at the usekiba.ai marketing apex. That is Karibi's Base44
# site, it serves a DIFFERENT privacy policy, and on 2026-07-29 that policy is
# what got A2P campaign CM6898f77d… rejected under error 30908: it carries no
# "not shared with third parties or affiliates for marketing" statement, no
# message-frequency disclosure, and an unqualified "we may share information
# with trusted service providers" line. It is also a client-rendered SPA, so an
# automated vetting scraper sees an empty page.
#
# A carrier reviewer WILL follow both links during A2P campaign review. Only set
# these once the marketing-site policy has been fixed and content-verified — a
# 200 is NOT verification, that false-passed once already. See TWILIO_A2P_SETUP.md.
# NEXT_PUBLIC_SMS_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=

# Price label on the onboarding trial summary. Keep in sync with the backend's
# STRIPE_PRICE_DISPLAY — if they drift, the signup page promises one price and
# the card gets charged another.
NEXT_PUBLIC_PRICE_DISPLAY=$9.99/mo

# Public base URL of THIS app. Used as Next's metadataBase, which is what makes
# link-preview image URLs absolute — without it iMessage/WhatsApp silently drop
# the card and the texted checkout link unfurls as a bare icon. Must be the host
# the texted links actually resolve to (the app host), NOT the marketing domain.
NEXT_PUBLIC_SITE_URL=https://onboarding.usekiba.ai

# KIBA's outbound number in E.164 — powers the "Open KIBA in Messages" button on
# the post-payment success page. Must match the number KIBA actually texts from
# (SendBlue line), or the button opens a thread with a number that never replies.
NEXT_PUBLIC_KIBA_SMS_NUMBER=+14695634418
