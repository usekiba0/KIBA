# App
NODE_ENV=development
PORT=3000
# Public-facing HTTPS URL for the backend — used for Twilio webhook signature validation
# THIS BACKEND's public URL — used to rebuild the signed URL for Twilio webhook
# signature validation. NOT the frontend: a mismatch 401s every inbound SMS, and
# the failure is silent because outbound keeps working.
APP_BASE_URL=https://kiba-1.onrender.com
# Frontend origin for CORS allowlist
FRONTEND_URL=https://usekiba.ai
SESSION_TIMEOUT_HOURS=4

# Internal admin API key — must be at least 32 chars — guards data export/delete & crisis resolution
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_generate_with_openssl_rand_hex_32

# Signs the texted /plan checkout links. Optional — falls back to
# INTERNAL_API_KEY if unset. Rotating either one invalidates every outstanding
# plan link, which is correct but worth knowing before rotating mid-beta.
CHECKOUT_LINK_SECRET=

# Database
DATABASE_URL=postgresql://kiba:kiba_local@localhost:5432/kiba

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # set in production

# Twilio (SMS/MMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550001234

# SendBlue (iMessage) — optional; SMS-only mode if not set
SENDBLUE_API_KEY_ID=your_sendblue_api_key_id
SENDBLUE_API_SECRET_KEY=your_sendblue_api_secret_key
SENDBLUE_SENDING_NUMBER=+15550001234

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_INDIVIDUAL=price_xxx
# Optional. The annual price shown alongside monthly on /plan. If unset, the
# plan page renders monthly-only rather than breaking — safe to deploy before
# the annual price exists in Stripe.
STRIPE_PRICE_ID_INDIVIDUAL_ANNUAL=price_xxx
STRIPE_PRICE_ID_COACH_PRO=price_xxx
STRIPE_PRICE_ID_COACH_ELITE=price_xxx
STRIPE_TRIAL_DAYS=7
# Human price label KIBA quotes in SMS/intake copy. MUST match the real amount
# on STRIPE_PRICE_ID_INDIVIDUAL (else the bot promises one price, Stripe charges
# another). Defaults to $20/month if unset.
STRIPE_PRICE_DISPLAY=$20/month

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxx
AI_MODEL=claude-haiku-4-5-20251001
# AI_MODEL=claude-sonnet-4-6   # override for higher accuracy
# Used for EVERY turn carrying an image: photos in conversation and proof-photo
# verification. Haiku's vision is too weak for both. Upgrade path is a 5-series
# id — claude-sonnet-5 is the same list price as 4.6 and is the first Sonnet with
# high-resolution vision (2576px vs 1568px on the long edge), which is exactly
# what reading food and storefronts needs. The request shape adapts on its own
# (see src/ai/model-params.ts), so this is a value change with no redeploy.
AI_VISION_MODEL=claude-sonnet-4-6
# AI_VISION_MODEL=claude-sonnet-5   # verify with: npx ts-node scripts/sim-vision.ts <image-url>
# Warn-only ceiling (input+output tokens) for flagging unexpectedly expensive
# LLM turns. Default 20000; lower it to investigate cost, raise to silence.
# TOKEN_BUDGET_WARN_TOKENS=20000

# Retention: one-time "pin our chat" how-to sent right after a user subscribes.
# Can be an image, GIF, or VIDEO — must be a public HTTPS URL SendBlue/Twilio can
# fetch (e.g. a file in the frontend's public/ folder or a CDN). Leave unset to
# disable entirely. PIN_CHAT_MEDIA_URL is preferred; PIN_CHAT_IMAGE_URL still works
# as a fallback. NOTE: iMessage handles video natively, but Android/MMS (Twilio)
# caps size — keep it a short GIF or a compressed <~1MB mp4 for cross-platform.
#
# CONTENT-TYPE MATTERS, and a 200 OK is NOT proof this works. The provider fetches
# the URL and silently drops the attachment if the type isn't a real media type —
# the text still sends, so it looks like a partial delivery with no error anywhere.
# Verify with:  curl -sIL <url> | grep -i content-type
#   https://onboarding.usekiba.ai/pin-chat.mp4   -> video/mp4              GOOD
#   https://kiba-blond.vercel.app/pin-chat.mp4   -> video/mp4              GOOD
#   https://raw.githubusercontent.com/.../*.mp4  -> application/octet-stream  BAD
#   https://usekiba.ai/pin-chat.mp4              -> text/html (404 page)   BAD
# raw.githubusercontent.com works for the .vcf contact card but NOT for video.
# PIN_CHAT_MEDIA_URL=https://onboarding.usekiba.ai/pin-chat.mp4

# Apple-masking Path B: one-time KIBA contact card (.vcf) sent right after a
# user subscribes, BEFORE the pin-chat nudge. Saving it makes every future text
# show "KIBA" instead of a bare number (Apple has no native branding for
# business-initiated texts) and defeats iOS "Screen Unknown Senders". The vcf
# carries both the SendBlue (iMessage) and Twilio (SMS) numbers. Regenerate the
# file with backend/scripts/gen-contact-card.js. Leave unset to disable.
# CONTACT_CARD_URL=https://raw.githubusercontent.com/usekiba0/KIBA/master/frontend/public/kiba-contact.vcf

# Crisis Detection — REQUIRED; app will not start without these
CRISIS_CONFIDENCE_THRESHOLD=0.65
CRISIS_COACH_ALERT_EMAIL=coach@usekiba.ai
CRISIS_COACH_ALERT_PHONE=+15550009999

# Email (for coach alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@usekiba.ai
SMTP_PASS=your_smtp_password
SMTP_FROM=KIBA Alerts <alerts@usekiba.ai>
